{
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(git --version)",
      "Bash(node knowledge/generate.mjs)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/resume-unfinished-build.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/harness-trigger.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}